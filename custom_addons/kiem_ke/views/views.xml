<odoo>
    <data>
        <record id="kiem_ke_action" model="ir.actions.act_window">
            <field name="name">Kiểm ke kho</field>
            <field name="res_model">kiem_ke.scanned_item</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="kiem_ke_view_form" model="ir.ui.view">
            <field name="name">kiem.ke.form</field>
            <field name="model">kiem_ke.scanned_item</field>
            <field name="arch" type="xml">
                <form string="Kiểm kê Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="barcode"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="scanned_by"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="kiem_ke_view_tree" model="ir.ui.view">
            <field name="name">Kiem ke view</field>
            <field name="model">kiem_ke.scanned_item</field>
            <field name="arch" type="xml">
                <list string="Danh sach kiem ke">
                    <field name="name"/>
                    <field name="barcode"/>
                    <field name="scanned_by"/>
                    <field name="scanned_at"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
